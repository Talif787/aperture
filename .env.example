# Local development configuration. Copy to .env, which is gitignored.
# Nothing here is a production secret; production values come from Secret Manager.

POSTGRES_USER=aperture
POSTGRES_PASSWORD=local-development-only
POSTGRES_DB=aperture
POSTGRES_PORT=5432

APERTURE_HTTP_ADDR=:8080
APERTURE_LOG_LEVEL=debug
APERTURE_ENVIRONMENT=local

# Set by the CI workflow from repository variables, never committed.
GCP_PROJECT_ID=
GCP_REGION=us-central1
